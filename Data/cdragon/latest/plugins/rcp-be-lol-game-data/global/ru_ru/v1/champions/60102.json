        {
            "spellKey": "e",
            "name": "Огненное дыхание",
            "abilityIconPath": "/lol-game-data/assets/ASSETS/UX/Jade/S3Icons/SameSized/ShyvanaFlameBreath.project_jade.png",
            "abilityVideoPath": "",
