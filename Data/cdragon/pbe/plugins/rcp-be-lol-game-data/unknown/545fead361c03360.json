            "spellKey": "q",
            "name": "الموجة السماوية",
            "abilityIconPath": "/lol-game-data/assets/ASSETS/UX/Jade/S3Icons/SameSized/KarmaHeavenlyWave_Jade34.project_jade.png",
            "abilityVideoPath": "",
