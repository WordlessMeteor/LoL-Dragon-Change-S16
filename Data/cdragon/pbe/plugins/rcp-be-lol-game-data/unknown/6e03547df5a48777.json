    "passive": {
        "name": "Derék harcos",
        "abilityIconPath": "/lol-game-data/assets/ASSETS/UX/Jade/S3Icons/SameSized/Poppy_ValiantFighter.project_jade.png",
        "abilityVideoPath": "",
        "abilityVideoImagePath": "",
        "description": "A Poppyt érő összes olyan fizikai és varázssebzés, amely meghaladja aktuális életerejének 10%-át, 50%-kal csökken. A hatás nem csökkenti az építmények által okozott sebzést."
