    "spells": [
        {
            "spellKey": "q",
            "name": "Pusztító ütés",
            "abilityIconPath": "/lol-game-data/assets/ASSETS/UX/Jade/S3Icons/SameSized/PoppyDevastatingBlow.project_jade.png",
            "abilityVideoPath": "",
            "abilityVideoImagePath": "",
            "cost": "@Cost@ @AbilityResourceName@",
            "cooldown": "@Cooldown@ mp %i:cooldown%",
            "description": "Poppy szétzúzza ellenfelét, a sebzésével, bónuszként egy fix értékkel, valamint ellenfele maximális életerejének 8%-ával egyenértékű sebzést okozva. A bónusz sebzés nem lépheti túl a szint által megszabott határértéket.",
            "dynamicDescription": "Poppy következő támadása <magicDamage>@FlatDamageCalc@ + a maximális életerő @HealthRatio*100@%-ával egyenlő varázssebzést</magicDamage> okoz. Az életerővel arányos bónusz sebzés maximális összege @HealthDamageCap@ lehet.@SpellModifierDescriptionAppend@",
