        {
            "spellKey": "w",
            "name": "Δεσμός του Πνεύματος",
            "abilityIconPath": "/lol-game-data/assets/ASSETS/UX/Jade/S3Icons/SameSized/KarmaSpiritBond_Jade34.project_jade_16_18.png",
