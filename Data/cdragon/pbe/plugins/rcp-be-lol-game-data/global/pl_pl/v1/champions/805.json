    "spells": [
        {
            "spellKey": "q",
            "name": "Rytualne Szpile",
            "abilityIconPath": "/lol-game-data/assets/ASSETS/Characters/Locke/HUD/Icons2D/Locke_Q.Locke.png",
            "abilityVideoPath": "",
            "abilityVideoImagePath": "",
            "cost": "@Cost@ pkt. (@AbilityResourceName@)",
            "cooldown": "@Cooldown@ sek. %i:cooldown%",
            "description": "Locke przygotowuje zestaw Duchowych Szpil do rzucenia, zadając obrażenia i oznaczając trafionych wrogów. Locke może wykorzystać te oznaczenia, by zadać dodatkowe obrażenia swoimi atakami.",
            "dynamicDescription": "Locke przygotowuje zestaw <keywordMajor>Duchowych Szpil</keywordMajor> do rzucenia, zadając <magicDamage>@MissileDamage@ pkt. obrażeń magicznych</magicDamage> i oznaczając trafionych wrogów. Szpile nakładają @SlowAmount1*100@/@SlowAmount2*100@/@SlowAmount3*100@% <status>spowolnienia</status> na @SlowDuration1@/@SlowDuration2@/@SlowDuration3@ sek., a efekt kumuluje się z liczbą trafień.<br><br>Atakowanie wroga zużywa <keywordMajor>Duchowe Szpile</keywordMajor>, zadając <magicDamage>@NailDamage@ pkt. obrażeń magicznych</magicDamage> za każdy ładunek. Wartość ta jest zwiększona o @TwoMarkBonusPercent@% i @ThreeMarkBonusPercent@% odpowiednio za dwie i trzy szpile.@SpellModifierDescriptionAppend@",
