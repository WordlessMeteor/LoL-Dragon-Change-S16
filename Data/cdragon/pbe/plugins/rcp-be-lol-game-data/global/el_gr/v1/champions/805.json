        {
            "spellKey": "e",
            "name": "Η Ωχρή Καταδίωξη",
            "abilityIconPath": "/lol-game-data/assets/ASSETS/Characters/Locke/HUD/Icons2D/Locke_E.Locke.png",
            "abilityVideoPath": "champion-abilities/0805/ability_0805_E1.webm",
