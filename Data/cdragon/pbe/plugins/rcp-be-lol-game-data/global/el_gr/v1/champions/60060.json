    "passive": {
        "name": "Βασίλισσα Αράχνη",
        "abilityIconPath": "/lol-game-data/assets/ASSETS/Characters/Jade_Elise/HUD/Icons2D/Jade_ElisePassive.project_jade_16_22.png",
        "abilityVideoPath": "",
